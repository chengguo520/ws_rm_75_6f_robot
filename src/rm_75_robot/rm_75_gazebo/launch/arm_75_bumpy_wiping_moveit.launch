<launch>
  <!--
    Convenience launch for sim_09.
    It reuses the normal RM75-6F Gazebo + MoveIt bringup, but swaps in the
    bumpy wiping-table world so the user can start the full scene with one file.
  -->
  <arg name="rvizconfig" default="$(find rm_75_gazebo)/config/rviz_gazebo.rviz"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="use_rgbd_camera" default="false"/>
  <arg name="use_two_finger_gripper" default="false"/>
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_software_rendering" default="true"/>
  <arg name="gazebo_software_rendering" default="false"/>

  <include file="$(find rm_75_gazebo)/launch/arm_75_bringup_moveit.launch">
    <arg name="rvizconfig" value="$(arg rvizconfig)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="$(arg debug)" />
    <arg name="use_rgbd_camera" value="$(arg use_rgbd_camera)" />
    <arg name="use_two_finger_gripper" value="$(arg use_two_finger_gripper)" />
    <arg name="use_rviz" value="$(arg use_rviz)" />
    <arg name="rviz_software_rendering" value="$(arg rviz_software_rendering)" />
    <arg name="gazebo_software_rendering" value="$(arg gazebo_software_rendering)" />
    <arg name="world_name" value="$(find rm_75_gazebo)/worlds/rm75_bumpy_wiping_table.world" />
  </include>
</launch>
